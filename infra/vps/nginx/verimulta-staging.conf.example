# Substitua staging.example.invalid por um domínio autorizado antes de instalar.
# Não habilite este arquivo em produção sem revisão independente.
server {
    listen 80;
    server_name staging.example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name staging.example.invalid;

    # Preencha com certificados do domínio de staging.
    ssl_certificate /etc/letsencrypt/live/staging.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.example.invalid/privkey.pem;

    client_max_body_size 8m;
    root /opt/verimulta-staging/frontend-react/dist;
    index index.html;

    # A API permanece no processo Node. Não aplicar cache a respostas privadas.
    location ^~ /v1/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    # Os arquivos multi-page do Vite têm precedência sobre qualquer app legado.
    location = / { try_files /index.html =404; }
    location = /app.html { try_files /app.html =404; add_header Cache-Control "no-store" always; }
    location = /admin.html { try_files /admin.html =404; add_header Cache-Control "no-store" always; }
    location = /sw.js { try_files /sw.js =404; add_header Cache-Control "no-cache" always; }
    location / { try_files $uri $uri/ =404; }
}
