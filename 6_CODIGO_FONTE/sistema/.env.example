# Copie para .env somente no ambiente correspondente e substitua todos os
# marcadores. Nunca versionar .env ou credenciais reais.
NODE_ENV=staging
PORT=3000
DB_PATH=./verimulta-staging.db

# Gere segredos diferentes para cada ambiente; não reutilize os valores abaixo.
JWT_SECRET=<gerar-segredo-jwt-do-staging>
ADMIN_SECRET=<gerar-segredo-admin-do-staging>
WEBHOOK_SECRET=<gerar-segredo-webhook-do-staging>

# Demo não deve ser usado para cobrança de produção.
GATEWAY=demo
MP_ACCESS_TOKEN=
URL_BASE=https://staging.exemplo.invalid

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
GOOGLE_VISION_KEY=

# Separe origens por vírgula. Não usar *.
ORIGENS_PERMITIDAS=http://localhost:5173
FUSO_HORARIO=America/Sao_Paulo
VERSAO_TERMOS=2026-01
VERSAO_APP=staging
FONTES_MONITORAMENTO=demo

# Integrações externas opcionais; mantenha desligadas até haver contrato.
FIPE_DESLIGADA=false
FIPE_BASE=https://brasilapi.com.br/api/fipe
FIPE_TIMEOUT_MS=8000
FONTE_HTTP_URL=
FONTE_HTTP_METODO=GET
FONTE_HTTP_TIMEOUT_MS=12000
FONTE_HTTP_OFICIAL=false
FONTE_HTTP_FORNECE=veiculo,multas
FONTE_HTTP_CABECALHOS=
FONTE_HTTP_CORPO=
FONTE_HTTP_RAIZ=
FONTE_HTTP_MAPA=
DEMO_NOVA_MULTA=false
